import {createRequire} from 'node:module';import express from 'express';import {promises as fs} from 'node:fs';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';
import {libraryRouter} from '../server/library.mjs';import {sessionRecords} from '../src/utils/sessionStream';import {defaultRegistration} from '../src/utils/libraryClient';
const require=createRequire(import.meta.url),{chromium}=require(process.env.IVCS_PLAYWRIGHT_MODULE || 'playwright');const root=await fs.mkdtemp(path.join(os.tmpdir(),'ivcs-overlay-')),app=express();app.use('/api/library',libraryRouter(root));app.use(express.static(path.resolve(process.env.IVCS_UI_DIST || 'dist')));app.get('*',(_req,res)=>res.sendFile(path.resolve(process.env.IVCS_UI_DIST || 'dist','index.html')));const server=app.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));const browser=await chromium.launch({headless:true,channel:process.env.IVCS_BROWSER_CHANNEL || (process.platform==='win32'?'msedge':undefined)});
try{
 const slices=Array.from({length:48},(_,z)=>({id:'slice-'+z,sliceIndex:z,sopInstanceUID:'1.2.3.'+(z+1),sopClassUID:'1.2.840.10008.5.1.4.1.1.2',rows:96,cols:128,huData:new Int16Array(96*128).fill(-1000),pixelSpacing:[1.5,.75],sliceThickness:3,sliceLocation:z*3,imagePositionPatient:[0,0,z*3],imageOrientationPatient:[1,0,0,0,1,0],minHU:-1000,maxHU:-1000,windowCenter:40,windowWidth:400,rescaleSlope:1,rescaleIntercept:0}));
 const study:any={id:'ref',patientId:'SYNTHETIC-OVERLAYS',patientName:'Synthetic overlays',modality:'CT',slices},roi:any={id:'r',name:'Overlay QA',type:'OAR',color:'#ff0000',visible:true,locked:false,opacity:0,maskScale:2,sliceMasks:{}};
 const file=path.join(root,'qa.ivcs');await fs.writeFile(file,[...sessionRecords({format:'radcontour-session',version:1,series:study,studies:[study],rois:[roi],activeRoiId:roi.id,currentSliceIndex:24,windowCenter:40,windowWidth:400,registrationState:defaultRegistration(study.id)})].join(''));
 const page=await browser.newPage({viewport:{width:1500,height:1000},deviceScaleFactor:2}),errors:string[]=[];page.on('pageerror',(e:any)=>errors.push(e.message));
 await page.addInitScript({content:'window.__name=(fn)=>fn;'});
 await page.addInitScript(()=>{const original=CanvasRenderingContext2D.prototype.arc;CanvasRenderingContext2D.prototype.arc=function(x,y,r,a,b,cc){if(this.strokeStyle==='#ffffff' || this.fillStyle==='#ff0000'){const m=this.getTransform(),box=this.canvas.getBoundingClientRect();const mark={x:m.a*x+m.c*y+m.e,y:m.b*x+m.d*y+m.f,rx:r*Math.hypot(m.a,m.b)*box.width/this.canvas.width,ry:r*Math.hypot(m.c,m.d)*box.height/this.canvas.height};if(this.strokeStyle==='#ffffff')(this.canvas as any).__ring=mark;if(this.fillStyle==='#ff0000')(this.canvas as any).__vertex=mark;}return original.call(this,x,y,r,a,b,cc);};const text=CanvasRenderingContext2D.prototype.fillText;CanvasRenderingContext2D.prototype.fillText=function(label,x,y,...args){if(label.endsWith(' mm')){const m=this.getTransform();(this.canvas as any).__measure={label,font:this.font,a:m.a,d:m.d};}return text.call(this,label,x,y,...args);};});
 await page.goto('http://127.0.0.1:'+(server.address() as any).port);await page.locator('input[accept=".json,.ivcs"]').setInputFiles(file);await page.waitForFunction(()=>document.querySelector('header')?.textContent?.includes('SYNTHETIC-OVERLAYS'));
 const measures:any[]=[];
 for(const layout of ['coronal','sagittal','oneplus2','triplanar']){
  await page.locator('#mpr-tab-'+layout).click();
  for(const plane of (layout==='coronal' || layout==='sagittal'?[layout]:['coronal','sagittal'])){
   const canvas=page.getByTestId('editable-'+plane).first();await canvas.waitFor();await page.waitForFunction((name:string)=>!!(document.querySelector('[data-testid="editable-'+name+'"]') as any)?.__ring,plane);
   for(const zoomed of [false,true]){
    if(zoomed){await canvas.hover();await page.keyboard.down('Control');await page.mouse.wheel(0,-200);await page.keyboard.up('Control');await page.waitForTimeout(150);}else await page.waitForTimeout(150);
    const m=await canvas.evaluate((c:HTMLCanvasElement)=>{const ring=(c as any).__ring,ctx=c.getContext('2d')!,d=ctx.getImageData(0,0,c.width,c.height).data;let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;for(let y=Math.round(ring.y)-15;y<=Math.round(ring.y)+15;y++)for(let x=Math.round(ring.x)-15;x<=Math.round(ring.x)+15;x++){if(x<0||y<0||x>=c.width||y>=c.height)continue;const i=(y*c.width+x)*4;if(d[i]>150&&d[i+1]>150&&d[i+2]>150){minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y);}}return {...ring,pixelWidth:maxX-minX+1,pixelHeight:maxY-minY+1,zoom:c.dataset.zoom};});
    if(process.env.IVCS_UI_DIST)await page.screenshot({path:'build/viewport-overlays-before.png'});
    assert.ok(Math.abs(m.rx-4)<.05 && Math.abs(m.ry-4)<.05,JSON.stringify({layout,plane,m}));assert.ok(Number.isFinite(m.pixelWidth)&&Math.abs(m.pixelWidth-m.pixelHeight)<=1,JSON.stringify({layout,plane,m}));measures.push({layout,plane,zoomed,...m});
   }
  }
  await page.screenshot({path:'build/viewport-overlays-'+layout+'.png'});
 }
 const canvas=page.getByTestId('editable-coronal').first();await page.locator('#btn-contour-tool-polygon').click();await page.locator('#btn-toggle-crosshairs').click();const box=await canvas.boundingBox();await page.mouse.click(box.x+box.width/2,box.y+box.height/2);await page.waitForTimeout(100);
 const vertex=await canvas.evaluate((c:any)=>c.__vertex);assert.ok(vertex && Math.abs(vertex.rx-4.5)<.05 && Math.abs(vertex.ry-4.5)<.05,JSON.stringify(vertex));await canvas.press('Escape');await page.locator('#btn-contour-tool-ruler').click();await page.mouse.move(box.x+box.width/2,box.y+box.height/2);await page.mouse.down();await page.mouse.move(box.x+box.width/2+40,box.y+box.height/2+30);await page.mouse.up();await page.waitForTimeout(100);const measurement=await canvas.evaluate((c:any)=>c.__measure);const expected=await canvas.evaluate((c:HTMLCanvasElement)=>{const box=c.getBoundingClientRect();return Math.hypot(40*c.width/box.width,30*c.height/box.height)*.375/Number(c.dataset.zoom);});assert.ok(Math.abs(parseFloat(measurement.label)-expected)<=.06,JSON.stringify({measurement,expected}));assert.equal(measurement.font,'11px monospace');assert.ok(Math.abs(measurement.a-measurement.d)<.01,JSON.stringify(measurement));await page.keyboard.down('Control');await page.mouse.wheel(0,-200);await page.keyboard.up('Control');await page.waitForTimeout(150);const zoomedMeasure=await canvas.evaluate((c:any)=>c.__measure);assert.equal(zoomedMeasure.label,measurement.label);assert.equal(zoomedMeasure.font,measurement.font);assert.deepEqual(errors,[]);console.log('PASS round crosshair raster and polygon vertices at anisotropic spacing, zoom, 1+2 and 2x2',JSON.stringify(measures));
}finally{await browser.close();server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));await fs.rm(root,{recursive:true,force:true});}
